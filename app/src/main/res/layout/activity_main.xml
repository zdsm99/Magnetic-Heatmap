<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="fill_parent"
        android:layout_height="match_parent">

    </org.osmdroid.views.MapView>

    <View
        android:id="@+id/fixStatus"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_alignParentTop="true"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/red_circle" />

    <ImageButton
        android:id="@+id/settingsBtn"
        android:contentDescription="@string/settingsDescription"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        app:srcCompat="@drawable/settings_icon" />

    <LinearLayout
        android:id="@+id/menu_container"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/border">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/measurement"
            android:padding="8dp"
            android:gravity="center"
            android:background="@color/t_green">


            <ImageView
                android:src="@drawable/arrow"
                android:contentDescription="@string/startDescription"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:id="@+id/measurementText"
                android:text="@string/startBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="16sp"/>

        </LinearLayout>
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@color/black" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/save_measurement"
            android:padding="8dp"
            android:gravity="center"
            android:background="@color/t_grey">


            <ImageView
                android:src="@drawable/arrow"
                android:contentDescription="@string/saveDescription"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:id="@+id/save_measurementText"
                android:text="@string/saveBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/grey"
                android:textSize="16sp"/>

        </LinearLayout>
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@color/black" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/center_map"
            android:padding="8dp"
            android:gravity="center"
            android:background="@color/t_grey">


            <ImageView
                android:src="@drawable/arrow"
                android:contentDescription="@string/zoomDescription"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:text="@string/zoomBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="16sp"/>

        </LinearLayout>
        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@color/black" />
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:id="@+id/follow_position"
            android:padding="8dp"
            android:gravity="center"
            android:background="@color/t_blue">


            <ImageView
                android:src="@drawable/arrow"
                android:contentDescription="@string/followDescription"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:id="@+id/followLocationText"
                android:text="@string/followBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="16sp"/>

        </LinearLayout>
    </LinearLayout>

    <!-- Informacje o punkcie -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/infoPanel">


        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/border_panel"
            android:padding="16dp"
            android:layout_gravity="top"
            android:layout_marginTop="100dp"
            >
            <TextView
                android:id="@+id/textPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:text="@string/position"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textCoordinateSystem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:text="@string/coordinateSystem"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textMagnetometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:text="@string/magentoReading"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
        <!-- Przycisk zamknięcia -->
        <TextView
            android:id="@+id/closePanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/exitBtn"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:layout_marginTop="100dp"
            android:layout_gravity="top|end"
            android:textColor="@android:color/black"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>